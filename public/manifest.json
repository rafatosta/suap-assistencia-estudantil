{
  "manifest_version": 3,
  "name": "SUAP — Assistência Estudantil",
  "description": "Base de extensão para apoiar fluxos autorizados de assistência estudantil no SUAP.",
  "version": "0.1.0",
  "action": {
    "default_title": "SUAP — Assistência Estudantil"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://suap.ifba.edu.br/*"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
